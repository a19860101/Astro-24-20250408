---
const {data, url} = Astro.props
---
<div class="card">
    <div class="card-hero">
        <img src={data.hero.src} alt="">
    </div>
    <h2>{data.title}</h2>
    <div>{data.pubDate.slice(0,10)}</div>
    <a href={url}>繼續閱讀</a>
</div>
<style>
    .card-hero {
        width: 100%;
        aspect-ratio: 4 / 3;
        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }
</style>