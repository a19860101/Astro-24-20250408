---
const {data, url} = Astro.props
---
<div class="card space-y-2">
    <div class="w-full aspect-4/3">
        <img src={data.hero.src} alt="" class="w-full h-full object-cover">
    </div>
    <h2 class="text-xl font-bold text-fuchsia-800">{data.title}</h2>
    <div class="text-sm text-slate-400">{data.pubDate.slice(0,10)}</div>
    <a href={url} class="bg-amber-300 px-4 py-2 text-sm inline-block rounded-lg">繼續閱讀</a>
</div>
<style>

</style>