---
import BaseLayout from "./BaseLayout.astro";
const {frontmatter} = Astro.props
---
<BaseLayout>
    <article>
        <h1>{frontmatter.title}</h1>
        <div>{frontmatter.author}</div>
        <div>發布日期:{frontmatter.pubDate}</div>
        <div>
            <slot />
        </div>
        <a href="/blog">文章列表</a>
    </article>
</BaseLayout> 
<style>
    article {
        width: 800px;
        margin: auto;
        line-height: 1.7;
        p {
            margin-bottom: 30px;
        }
    }
</style>