---
import BaseLayout from "./BaseLayout.astro";
const {frontmatter} = Astro.props
---
<BaseLayout>
    <article class="w-200 mx-auto my-5">
        <div class=" aspect-video mb-4">
            <img src={frontmatter.hero.src} alt="" class="w-full h-full object-cover">
        </div>
        <h1 class="text-2xl font-bold">{frontmatter.title}</h1>
        <div class="text-sm text-slate-500">{frontmatter.author}</div>
        <div class="text-sm text-slate-500">發布日期:{frontmatter.pubDate}</div>
        <hr class="my-5">
        <div class="leading-8">
            <slot />
        </div>
        <br>
        <a href="/blog"class="bg-amber-300 px-4 py-2 text-sm inline-block rounded-lg hover:bg-amber-200 duration-500">文章列表</a>
        <a href="#" class="bg-teal-300 px-4 py-2 text-sm inline-block rounded-lg hover:bg-teal-200 duration-500" onclick="history.back()">上一頁</a>
    </article>
</BaseLayout> 
<style>
</style>