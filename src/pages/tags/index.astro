---
import BaseLayout from "../../layouts/BaseLayout.astro"
const allPosts = Object.values(import.meta.glob('../blog/posts/*.md',{eager: true}))
const uniqueTags = [...new Set(allPosts.map((post:any)=>post.frontmatter.tags).flat())]
---
<BaseLayout>
    <h1 class="text-xl font-bold text-center">所有標籤</h1>
    <div class="flex flex-wrap w-150 mx-auto gap-4 justify-center">
        {
            uniqueTags.map((tag:any)=><a href={`tags/${tag}`} class="hover:bg-amber-400 text-sm py-1 px-3 bg-amber-300 rounded-xl">{tag}</a>)
        }
    </div>
</BaseLayout>
