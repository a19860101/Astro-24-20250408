---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
export function getStaticPaths(){
    const allPosts = Object.values(import.meta.glob('../blog/posts/*.md',{eager: true}))
    // const uniqueTags = [...new Set(allPosts.map((post:any) => post.frontmatter.tags).flat())]
    const uniqueTags = Array.from(new Set(allPosts.map((post:any) => post.frontmatter.tags).flat()))
    // return [
    //     {params: {tag: 'astro'},props:{posts: allPosts}},
    //     {params: {tag: '測試'},props:{posts: allPosts}},
    //     {params: {tag: '未知的首爾'},props:{posts: allPosts}}
    // ]
    return uniqueTags.map((tag:any)=>{
        const filterPosts = allPosts.filter((post:any)=>post.frontmatter.tags.includes(tag))
        return {
            // params: {tag: tag},
            params: {tag},
            props: {posts: filterPosts}
        }
    })

}
const {tag} = Astro.params
const {posts} = Astro.props
---
<BaseLayout>
    <h1 class="text-xl font-bold text-center my-6">標籤:{tag}</h1>
    <div class="flex flex-wrap w-150 mx-auto gap-4 justify-center">
        <a href="/tags" class="hover:bg-amber-400 text-sm py-1 px-3 bg-amber-300 rounded-xl">所有標籤</a>
    </div>
    <div class="w-200 mx-auto flex flex-wrap">
        {
                posts.map( (post:any) => 
                <div class="w-1/3 p-2">
                    <Card data={post.frontmatter} url={post.url}/>
                </div>
            )
        }
    </div>
</BaseLayout>