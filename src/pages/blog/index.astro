---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md',{eager: true}))
---
<BaseLayout pageTitle="Blog">
    <h1>Blog 123</h1>
    <div class="container">
        
        {
                allPosts.map( (post:any) => 
                <div class="col">
                    <Card data={post.frontmatter} url={post.url}/>
                </div>
            )
        }
    </div>
</BaseLayout>
<style>
    h1 {
        text-align: center;
        padding: 30px;
    }
    .container {
        display: flex;
        flex-wrap: wrap;
        width: 800px;
        margin: auto;
    }
    .col {
        width: 33.3333%;
        padding: 10px;
    }
</style>